# Geography / SEO. For a city subdomain, fill the forms for that city.
VITE_CITY_NAME=Россия
VITE_CITY_GENITIVE=России
VITE_CITY_PREPOSITIONAL=России
VITE_CITY_REGION=Россия
VITE_CITY_SUBDOMAIN=
VITE_CITY_IS_DEFAULT=true

# Domain configuration.
VITE_BASE_DOMAIN=boykovgroup.ru
VITE_SITE_PROTOCOL=https
VITE_SITE_ORIGIN=https://boykovgroup.ru

# Legal pages. Override if the new domain will have its own copies.
VITE_PRIVACY_URL=https://boykovgroup.ru/privacy
VITE_PERSONAL_DATA_URL=https://boykovgroup.ru/personal-data
VITE_OFFER_URL=https://boykovgroup.ru/oferta

# Endpoint that accepts JSON lead submissions. The integrated server uses the same-origin route below.
VITE_LEAD_ENDPOINT=/api/leads

# Yandex Metrica. Use the numeric counter ID from your Metrica counter.
VITE_YANDEX_METRICA_ID=
VITE_YANDEX_METRICA_ENABLED=true
VITE_YANDEX_METRICA_WEBVISOR=true
