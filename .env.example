# Frontend site configuration.
VITE_BASE_DOMAIN=pasport-bezopasnosty.ru
VITE_SITE_PROTOCOL=https
VITE_SITE_ORIGIN=https://pasport-bezopasnosty.ru

# Same-origin endpoint used by public lead forms.
VITE_LEAD_ENDPOINT=/api/leads

# Yandex Metrica.
# Leave the counter ID empty when Metrica is not configured.
VITE_YANDEX_METRICA_ID=
VITE_YANDEX_METRICA_ENABLED=true
VITE_YANDEX_METRICA_WEBVISOR=true


# Server process.
#
# SERVER_ENV_FILE is a process-level override for the env file path.
# It must be set before Node starts; putting it inside the selected
# env file cannot change which file is loaded.
SERVER_ENV_FILE=.env.server

NODE_ENV=production
HOST=0.0.0.0
PORT=8787
CLIENT_DIR=dist/client
BASE_DOMAIN=pasport-bezopasnosty.ru

# Express trust proxy configuration.
# Production nginx is one proxy hop in front of the Node server.
TRUST_PROXY=1


# Lead API protection and storage.
LEAD_BODY_LIMIT=1mb
LEAD_RATE_WINDOW_MS=600000
LEAD_RATE_MAX=8
LEAD_DEDUPE_TTL_MS=86400000

# Additional allowed origins, comma-separated.
# Same-origin requests are already allowed automatically.
LEAD_ALLOWED_ORIGINS=

LEADS_BACKUP_ENABLED=true
LEADS_FILE=data/leads.jsonl


# Internal visit statistics.
VISITS_FILE=data/visits.jsonl
VISIT_DEDUPE_TTL_MS=1800000
VISIT_RATE_WINDOW_MS=600000
VISIT_RATE_MAX=30


# Telegram notifications for new leads.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_MS=10000


# SMTP and email notifications.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=20000

# Sender defaults to SMTP_USER when empty.
LEAD_EMAIL_FROM=

# Primary recipient for lead notifications.
LEAD_EMAIL_TO=


# Admin dashboard.
# Always use strong production-only values in .env.server.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=


# Automated reports and regulation reminders.
#
# DAILY_REPORT_EMAIL falls back to the project report address
# when left empty.
DAILY_REPORT_EMAIL=

# Falls back to LEAD_EMAIL_TO when empty.
REGULATION_EMAIL_TO=

# Relative paths are resolved from the project root.
REGULATION_PUBLISHED_PAGE=../../current/pasport-bezopasnosti-gostinicy/index.html


# Site monitor notifications.
#
# The monitor also reads /etc/passport-monitor.env, so these may
# be configured there instead of .env.server.
MONITOR_EMAIL_TO=
MONITOR_TELEGRAM_BOT_TOKEN=
MONITOR_TELEGRAM_CHAT_ID=
