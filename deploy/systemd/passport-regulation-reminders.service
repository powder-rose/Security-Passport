[Unit]
Description=Passport regulation expiry reminders

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/pasport-bezopasnosty.ru/app/passport-security-base
Environment=REGULATION_REGISTRY_FILE=/var/www/pasport-bezopasnosty.ru/shared/regulations/regulations.json
ExecStart=/usr/bin/node /var/www/pasport-bezopasnosty.ru/app/passport-security-base/server/regulations/regulation-reminders.mjs
