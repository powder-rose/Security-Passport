{
  "name": "passport-security",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run qa && npm run build:client && npm run build:ssr && npm run prerender && npm run qa:dist",
    "build:client": "vite build --outDir dist/client",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist/server",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview --outDir dist/client",
    "qa": "node scripts/qa.mjs && npm run qa:regulations && npm run server:check",
    "qa:dist": "node scripts/qa.mjs --dist",
    "dev:api": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "server:check": "node --check server/index.mjs",
    "qa:regulations": "node scripts/qa-regulations.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"server/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"server/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{js,json,md}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "formidable": "^3.5.4",
    "nodemailer": "^10.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.3",
    "react-helmet-async": "^2.0.5",
    "react-redux": "^9.1.2",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.24.6",
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
